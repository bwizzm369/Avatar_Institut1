# Avatar Institut — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (no trailing slash). Canonical origin for
# certificate QR codes → {NEXT_PUBLIC_APP_URL}/verify/AVT-YYYY-NNNNNN
# Local: http://localhost:3000
# Vercel beta: set this to the exact HTTPS beta origin (no trailing slash).
# Do not invent a domain. Do not leave this as localhost on Vercel.
# Production must be https (never localhost) before issuing official PDFs.
# Auth emails use {NEXT_PUBLIC_APP_URL}/auth/callback
# Add that callback URL to Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth & PostgreSQL) ---
# Public placeholders only — replace locally; never commit real keys.
# This project reads NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (not ANON_KEY).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Prefer SUPABASE_SECRET_KEY; SERVICE_ROLE_KEY is a legacy alias.
# Never expose to the browser or NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=your-supabase-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Future integrations (leave empty until each phase) ---
# Stripe (server-side only for secrets — Test keys first, never Live without approval)
# Beta must use pk_test_ / sk_test_ / Test Price IDs only.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Student Pass Price IDs (Test). Never put a secret or amount in NEXT_PUBLIC_*.
STRIPE_STUDENT_PASS_MONTHLY_PRICE_ID=price_your_student_pass_monthly
STRIPE_STUDENT_PASS_SEMIANNUAL_PRICE_ID=price_your_student_pass_semiannual
STRIPE_STUDENT_PASS_ANNUAL_PRICE_ID=price_your_student_pass_annual

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Bunny Stream (signed URLs only — never permanent public links)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=

# Administrative email verification HMAC. Required. Server-only.
# Independent of SUPABASE_SECRET_KEY. No fallback.
# If empty, admin verification fails closed.
# Never commit a real value. Never expose as NEXT_PUBLIC_*.
ADMIN_EMAIL_VERIFICATION_SECRET=

# --- Resend (server-only administrative mailer) ---
# Never expose as NEXT_PUBLIC_*. Never commit a real API key.
# From address is always Avatar Institut Security <security@{RESEND_EMAIL_DOMAIN}>.
# Reply-To is contact@avatarinstitut.com.
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=mail.avatarinstitut.com
