# Avatar Institut — environment template
# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (no trailing slash). Also the canonical origin for
# certificate QR codes → {NEXT_PUBLIC_APP_URL}/verify/AVT-YYYY-NNNNNN
# Production must be https (never localhost) before issuing official PDFs.
# Password reset emails use {NEXT_PUBLIC_APP_URL}/auth/callback?next=/update-password
# Add that callback URL to Supabase Auth → URL Configuration → Redirect URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Auth & PostgreSQL) ---
# Public placeholders only — replace locally; never commit real keys.
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only. Never expose to the browser or NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Future integrations (leave empty until each phase) ---
# Stripe (server-side only for secrets — Test keys first, never Live without approval)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring Student Pass Price IDs (Test). Never put a secret or amount in NEXT_PUBLIC_*.
STRIPE_STUDENT_PASS_MONTHLY_PRICE_ID=price_your_student_pass_monthly
STRIPE_STUDENT_PASS_SEMIANNUAL_PRICE_ID=price_your_student_pass_semiannual
STRIPE_STUDENT_PASS_ANNUAL_PRICE_ID=price_your_student_pass_annual

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Bunny Stream (signed URLs only — never permanent public links)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
