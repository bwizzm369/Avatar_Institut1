# Avatar Institut — environment template (phase 1)
# Copy to .env.local for local development. Never commit real secrets.

# Public site URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Future integrations (leave empty until each phase) ---
# Supabase Auth & PostgreSQL
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (server-side only for secrets)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Bunny Stream (signed URLs only — never permanent public links)
BUNNY_STREAM_LIBRARY_ID=
BUNNY_STREAM_API_KEY=
BUNNY_STREAM_CDN_HOSTNAME=
